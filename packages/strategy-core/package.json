{
  "name": "@crypton/strategy-core",
  "version": "0.1.0",
  "license": "AGPL-3.0-only",
  "private": true,
  "description": "Estrategias de bot como funciones PURAS: validate(), preview(), plan(). Sin red, sin BD y sin dependencias de exchange — por eso se puede testear entera sin tocar un DEX.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "test": "jest",
    "test:watch": "jest --watch",
    "lint": "echo noop"
  },
  "dependencies": {
    "@crypton/shared": "workspace:*",
    "decimal.js": "^10.6.0"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.0",
    "jest": "^30.0.0",
    "ts-jest": "^29.2.5",
    "typescript": "^5.7.3"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "rootDir": "src",
    "testRegex": "\\.spec\\.ts$",
    "moduleNameMapper": {
      "^@crypton/shared$": "<rootDir>/../../shared/src/index.ts"
    }
  }
}
