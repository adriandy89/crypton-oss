{
  "compilerOptions": {
    "module": "commonjs",
    "moduleResolution": "node",
    "target": "ES2023",
    "lib": ["ES2023"],
    "declaration": true,
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "strictNullChecks": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "incremental": true
  },
  "include": ["src/**/*.ts"],
  "// exclude": "Los specs quedan FUERA del build: sin esta línea se compilan a dist/ y sus tipos acaban en la superficie .d.ts que consumen la API y el worker.",
  "exclude": ["node_modules", "dist", "**/*.spec.ts"]
}
