# ═══════════════════════════════════════════════════════════════
# CRYPTON — variables del stack de Docker
# ═══════════════════════════════════════════════════════════════
#
# Copia este fichero a `.env` (en esta misma carpeta) y rellena lo marcado
# como OBLIGATORIO. El resto tiene valores por defecto razonables.
#
#   cp .env.example .env
#
# Este fichero configura los CONTENEDORES. Para correr la API y el worker en el
# host durante el desarrollo, los ficheros son apps/api/.env y apps/worker/.env,
# que apuntan a localhost en vez de a los nombres de servicio.

# ═══════════════════════════════════════════════════════════════
# Puertos publicados en el host
# ═══════════════════════════════════════════════════════════════
# No son los estándar a propósito: así conviven con otros stacks de Postgres o
# Redis que ya tengas corriendo en la misma máquina.
DB_PORT=5341
REDIS_PORT=6381
API_PORT=3200
# Cliente web (la misma app que la de Android, servida por nginx).
APP_PORT=8100

# ═══════════════════════════════════════════════════════════════
# Base de datos
# ═══════════════════════════════════════════════════════════════
POSTGRES_DB=crypton
POSTGRES_USER=postgres
# Cámbiala si el puerto de Postgres queda expuesto fuera de la máquina.
POSTGRES_PASSWORD=postgres

# ═══════════════════════════════════════════════════════════════
# Redis
# ═══════════════════════════════════════════════════════════════
REDIS_PASSWORD=changeme

# ═══════════════════════════════════════════════════════════════
# CIFRADO DE CREDENCIALES  ← OBLIGATORIO
# ═══════════════════════════════════════════════════════════════
# Clave maestra con la que se cifran las claves de firma de los exchanges.
#
#   openssl rand -hex 32
#
# Se define AQUÍ una sola vez y el compose la inyecta a la API y al worker. Eso
# garantiza que coincidan: si cada servicio la leyera de su propio fichero, un
# despiste dejaría al worker sin poder descifrar lo que la API cifró y ningún
# bot arrancaría.
#
# Si se pierde, NINGUNA credencial guardada se puede volver a descifrar y todos
# los usuarios tendrán que dar de alta sus conexiones otra vez. Guárdala aparte
# del backup de la base de datos: tenerlas juntas anula el propósito de cifrar.
#
# Para rotarla sin downtime, admite varias separadas por comas:
#   CREDENTIALS_MASTER_KEY=v1:<hex-vieja>,v2:<hex-nueva>
#   CREDENTIALS_ACTIVE_KEY_ID=v2
CREDENTIALS_MASTER_KEY=
CREDENTIALS_ACTIVE_KEY_ID=v1

# ═══════════════════════════════════════════════════════════════
# JWT  ← OBLIGATORIO
# ═══════════════════════════════════════════════════════════════
# Dos secretos DISTINTOS. Con el mismo valor, un access token caducado serviría
# como refresh token y la sesión no expiraría nunca.
#
#   openssl rand -hex 32
JWT_ACCESS_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=
JWT_REFRESH_TTL=30d

# ═══════════════════════════════════════════════════════════════
# ACCESO CON GOOGLE  ← OBLIGATORIO
# ═══════════════════════════════════════════════════════════════
# La única forma de entrar. No hay contraseñas: la identidad la acredita Google
# y la verificación en dos pasos vive en la cuenta de Google del usuario.
#
# Credenciales OAuth 2.0 de tipo «aplicación web» en console.cloud.google.com.
# El URI de redirección que declares allí tiene que ser EXACTAMENTE el mismo que
# GOOGLE_REDIRECT_URI: Google compara la cadena entera.
#
# Tipo «aplicación web» también para el móvil, no «Android»: el código lo canjea
# la API, no el dispositivo, así que el secreto no viaja nunca al teléfono.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://api.crypton.example/api/v1/auth/google/callback

# Los dos únicos destinos a los que la API devuelve el navegador cuando Google
# ya ha respondido. La app elige cuál de los dos, nunca la URL.
APP_REDIRECT_WEB=https://app.crypton.example/auth/callback
APP_REDIRECT_NATIVE=com.crypton.app://auth/callback

# ═══════════════════════════════════════════════════════════════
# API
# ═══════════════════════════════════════════════════════════════
# Swagger apagado en producción: publica el mapa completo de la API.
SWAGGER_ENABLE=false

# Orígenes extra para CORS, separados por comas. Los de Capacitor
# (capacitor://localhost, https://localhost) ya van incluidos por defecto.
#
# El cliente web del stack (servicio `app`) NO hace falta ponerlo aquí: nginx
# sirve aplicación y API en el mismo origen, así que sus peticiones nunca son
# de origen cruzado. Esto es solo para clientes servidos desde otro dominio.
PUBLIC_APP_URL=

THROTTLE_TTL=30000
THROTTLE_LIMIT=100

# ═══════════════════════════════════════════════════════════════
# Motor de bots
# ═══════════════════════════════════════════════════════════════
# Cada cuánto busca bots huérfanos que adoptar.
ENGINE_SCAN_INTERVAL_MS=5000

# Latido de reconciliación: el techo de latencia cuando el WebSocket del venue se
# cae en silencio. Hasta ahí el bot converge igualmente por REST. Bajarlo mucho
# multiplica las llamadas al exchange sin ganar apenas, porque los fills ya
# disparan un tick inmediato.
RECONCILE_INTERVAL_MS=15000

# Vida del lease de un bot. Si un worker muere, otro lo adopta pasado este
# tiempo. Demasiado corto provoca relevos por un simple pico de latencia;
# demasiado largo alarga el hueco en el que nadie atiende al bot.
WORKER_LEASE_TTL_MS=30000

# Cuántas réplicas del motor levanta el stack. Cada una se queda con los bots
# cuyo lease consiga, hasta su tope: se escala añadiendo réplicas, no subiendo
# el tope de una sola.
WORKER_REPLICAS=1

# Cuántos bots acepta CADA réplica.
WORKER_MAX_BOTS=250

# ── Caudal hacia los venues ────────────────────────────────────
# Los DEX limitan en dos ámbitos y hay un ajuste para cada uno.

# Por CUENTA de exchange. El adaptador se comparte entre todos los bots de una
# misma cuenta, así que este número significa lo que dice.
VENUE_RATE_LIMIT_PER_SECOND=8

# Por IP de salida. Las réplicas de este compose comparten IP, así que deben
# compartir este valor: es lo que las hace compartir presupuesto en Redis.
# `memory` solo si cada réplica sale por su propia IP.
WORKER_EGRESS_ID=shared

# Cuánto vale una lectura de estado de cuenta antes de repetirla. Es lo que
# hace que diez bots de la misma cuenta latiendo a la vez cuesten UNA llamada.
ACCOUNT_STATE_TTL_MS=1000

# Caudal del feed público de precios: un adaptador sin credenciales por venue,
# compartido por todos los bots de todos los usuarios.
MARKETDATA_RATE_LIMIT_PER_SECOND=6

DRY_RUN_BALANCE=10000

# Retención de las series temporales. El histórico real (ciclos, órdenes y
# ejecuciones) NO se purga nunca; esto solo afecta a gráficas y timeline.
RETENTION_SNAPSHOT_DAYS=30
RETENTION_EVENT_DAYS=90
RETENTION_CRITICAL_EVENT_DAYS=365

# Bitácora de actividad: registra acciones de usuario y fallos HTTP en
# `activity_log`. Apagada por defecto — guarda datos personales (IP) y solo la
# lee un ADMIN. Enciéndela cuando quieras analizar qué está pasando.
AUDIT_LOG_ENABLE=false
RETENTION_AUDIT_DAYS=180

# ═══════════════════════════════════════════════════════════════
# Comisiones de plataforma (opcional)
# ═══════════════════════════════════════════════════════════════
# Dirección que recibe la comisión y su tasa en décimas de punto básico
# (1 = 0,0001 %). Solo se adjunta a las órdenes de las cuentas que hayan FIRMADO
# la aprobación en el venue: sin ella, el exchange rechaza la orden entera, no
# solo la comisión.
BUILDER_ADDRESS=
BUILDER_FEE_TENTH_BPS=0

# ═══════════════════════════════════════════════════════════════
# Telegram (opcional)
# ═══════════════════════════════════════════════════════════════
# Sin token, las alertas quedan desactivadas y el resto del motor funciona igual.
# El token solo lo necesita el WORKER; la API únicamente el nombre del bot, para
# construir el enlace que abre el chat. Cuantos menos procesos tengan el token,
# menos superficie de fuga.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

# ── Fuentes de precio externas (opcional) ──────────────────────
# Solo las usa el Market Maker V2 cuando su fuente no es el propio exchange:
# cotizar contra el mid del propio libro ancla al bot a un precio que el mismo
# mueve. APIs publicas de LECTURA, sin credenciales — aqui Binance es un oraculo,
# nunca un sitio donde se opere.
#
# La reparte `sourceMarketType`: SPOT usa REST; PERP e INDEX usan FAPI (futuros
# USDs-M). Si la fuente se cae, el bot deja de cotizar y avisa con
# FAIR_PRICE_STALE en vez de caer al precio del venue.
#
# Las consume el WORKER. Si las cambias aqui, el compose ya se encarga de
# pasarselas.
BINANCE_REST_URL=https://api.binance.com
BINANCE_FAPI_URL=https://fapi.binance.com

# ═══════════════════════════════════════════════════════════════
# Lighter — cuenta de servicio para datos publicos
# ═══════════════════════════════════════════════════════════════
# OPCIONAL, pero sin ella Lighter nos cuenta como cuenta «Standard» y el cupo
# son 60 PETICIONES POR MINUTO para toda la IP de salida, compartidas con
# cualquier otro proceso que salga por ella. Al pasarse, su cortafuegos deja de
# responder JSON y devuelve una pagina CAPTCHA de AWS WAF durante 60 segundos.
#
#   https://apidocs.lighter.xyz/docs/rate-limits
#   «To bypass IP-based rate limits, clients can authenticate each request so
#    that only L1-based rate limits apply.»
#
# Esta cuenta NO opera: solo lee mercados, precios y velas, y nunca firma una
# orden. Por eso no es la de ningun usuario —este camino no debe descifrar la
# clave de nadie para leer un precio— y por eso pasarla al tier «Plus» no cuesta
# nada: Plus cobra 0,5 puntos basicos por OPERACION, y esta cuenta no hace
# ninguna.
#
# Como conseguirlas:
#   1. Crear (o reutilizar) una cuenta de Lighter que no vaya a operar.
#   2. Registrar una clave de API en un indice entre 4 y 254. Los indices 0-3
#      los reserva Lighter para sus aplicaciones de escritorio y movil: usar uno
#      de esos pisa la sesion de la interfaz oficial.
#   3. Opcional pero recomendado: llamar a `changeAccountTier` para pasarla a
#      «Plus» (sin stakear nada). Exige no tener posiciones ni ordenes abiertas
#      y que hayan pasado 24 h desde la ultima llamada — en una cuenta que no
#      opera se cumple solo. Sube el cupo a 120.000 ponderadas por minuto.
#
# Sin rellenar, el sistema arranca igual y ANUNCIA en el log que va sin firmar.
LIGHTER_SERVICE_ACCOUNT_INDEX=
LIGHTER_SERVICE_API_KEY_INDEX=4
LIGHTER_SERVICE_PRIVATE_KEY=

# Nota sobre los otros dos venues: no tienen equivalente y no es un olvido.
# Hyperliquid sirve sus endpoints `info` sin credencial, y Aster documenta que
# «the limits on the API are based on the IPs, not the API keys» — una clave
# alli no cambiaria ningun limite.

# ── Configuraciones sugeridas al crear un bot (opcional) ──
# Sin clave, o con el interruptor apagado, se sirven configuraciones calculadas
# por reglas: la funcion sigue viva y la API arranca igual.
#
# La clave se saca en https://openrouter.ai/keys, sobre una cuenta con saldo
# (OpenRouter cobra por uso). Se queda en el servidor: la app y el APK no la ven
# ni la necesitan.
#
# El modelo va en la forma `proveedor/modelo` y debe soportar SALIDAS
# ESTRUCTURADAS; si no, no recibira ninguna peticion y todo saldra por reglas.
#
# El limite diario cuenta llamadas PAGADAS por usuario, no peticiones: mirar el
# mismo par varias veces lo sirve el cache y no gasta. Se reinicia a medianoche
# UTC.
AI_ADVISOR_ENABLE=false
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-sonnet-5
AI_ADVISOR_DAILY_LIMIT=20

# Fuentes de velas historicas para el backtesting (solo ADMIN). Ver
# apps/api/.env.example para el porque de cada una.
BYBIT_REST_URL=https://api.bybit.com
