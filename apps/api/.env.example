# ═══════════════════════════════════════════════════════════════
# Servidor
# ═══════════════════════════════════════════════════════════════
NODE_ENV=development
API_PORT=3200
SWAGGER_ENABLE=true

# ═══════════════════════════════════════════════════════════════
# Base de datos — stack-docker/docker-compose.yml publica Postgres en 5341
# ═══════════════════════════════════════════════════════════════
DATABASE_URL=postgresql://postgres:postgres@localhost:5341/crypton?schema=public&connection_limit=10

# ═══════════════════════════════════════════════════════════════
# Redis — cache de sesion, cerrojos y bus de eventos
# ═══════════════════════════════════════════════════════════════
# Solo la URL: HOST, PORT y DB por separado existian para BullMQ, que estaba
# registrado sin una sola cola detras. Nada los lee ya.
REDIS_URL=redis://localhost:6381
REDIS_PASSWORD=changeme

# ═══════════════════════════════════════════════════════════════
# CIFRADO DE CREDENCIALES  ← lo mas sensible de todo el fichero
# ═══════════════════════════════════════════════════════════════
# Clave maestra con la que se cifran las claves de firma de los exchanges.
# Generala con:  openssl rand -hex 32
#
# Si se pierde, NINGUNA credencial guardada se puede volver a descifrar y todos
# los usuarios tendran que dar de alta sus conexiones otra vez. Copia de
# seguridad aparte del backup de la base de datos: guardar ambas cosas juntas
# anula el proposito de cifrar.
#
# Para rotarla sin downtime, admite varias separadas por comas:
#   CREDENTIALS_MASTER_KEY=v1:<hex-vieja>,v2:<hex-nueva>
#   CREDENTIALS_ACTIVE_KEY_ID=v2
CREDENTIALS_MASTER_KEY=
CREDENTIALS_ACTIVE_KEY_ID=v1

# ═══════════════════════════════════════════════════════════════
# JWT
# ═══════════════════════════════════════════════════════════════
# Los dos secretos deben ser DISTINTOS entre si, y no es una recomendacion de
# estilo: con el mismo valor, un token de ACCESO caducado sigue verificando como
# token de REFRESCO, y entonces la sesion no expira nunca — que es justo lo
# contrario de lo que consigue un TTL de quince minutos.
#
# Se generan con:
#
#   openssl rand -hex 32
#
# Cambiarlos invalida todas las sesiones abiertas: los usuarios vuelven a entrar
# con Google, no pierden nada.
JWT_ACCESS_SECRET=change-me-access
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=change-me-refresh
JWT_REFRESH_TTL=30d

# ═══════════════════════════════════════════════════════════════
# ACCESO CON GOOGLE  ← la unica forma de entrar
# ═══════════════════════════════════════════════════════════════
# No hay contrasenas en esta plataforma. La identidad la acredita Google y la
# verificacion en dos pasos vive en la cuenta de Google del usuario.
#
# Como se obtienen estas credenciales:
#
#   1. console.cloud.google.com  ->  APIs y servicios  ->  Credenciales
#   2. Crear credenciales  ->  ID de cliente de OAuth  ->  Aplicacion web
#   3. En "URIs de redireccionamiento autorizados", anade EXACTAMENTE el valor
#      de GOOGLE_REDIRECT_URI de abajo. Google compara la cadena entera: sobra
#      una barra final y deja de funcionar.
#
# Tipo "aplicacion web" tambien para la app de movil, y no "Android": el codigo
# lo canjea esta API, no el dispositivo. Asi el client_secret no viaja nunca al
# telefono y el redirect de Google apunta a una URL HTTPS nuestra, no a un
# esquema propio que cualquier otra aplicacion instalada podria reclamar.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3200/api/v1/auth/google/callback

# A donde devuelve la API el navegador cuando Google ya ha respondido. Son dos
# destinos FIJOS y la app solo elige cual de los dos: si la URL viniera en la
# peticion, esto seria un redirect abierto con una sesion recien creada dentro.
#
# El nativo es el enlace profundo de la app (appId de capacitor.config.ts). Para
# que Android lo entregue hace falta el intent-filter correspondiente; con
# `ionic cap sync` Capacitor ya lo genera a partir del appId.
APP_REDIRECT_WEB=http://localhost:8100/auth/callback
APP_REDIRECT_NATIVE=com.crypton.app://auth/callback

# ═══════════════════════════════════════════════════════════════
# Limitacion de caudal
# ═══════════════════════════════════════════════════════════════
THROTTLE_TTL=30000
THROTTLE_LIMIT=100

# Origenes extra para CORS, separados por comas. Los de Capacitor
# (capacitor://localhost, https://localhost) ya van incluidos por defecto.
PUBLIC_APP_URL=http://localhost:8100

# ═══════════════════════════════════════════════════════════════
# Comisiones de plataforma (builder / integrator)
# ═══════════════════════════════════════════════════════════════
# Direccion que recibe la comision y su tasa en decimas de punto basico
# (1 = 0,0001 %). Solo se adjunta a las ordenes de las cuentas que hayan
# FIRMADO la aprobacion en el venue: sin ella, el exchange rechaza la orden
# entera, no solo la comision.
BUILDER_ADDRESS=
BUILDER_FEE_TENTH_BPS=0

# ═══════════════════════════════════════════════════════════════
# Telegram
# ═══════════════════════════════════════════════════════════════
# La API solo necesita el NOMBRE del bot, para construir el enlace profundo que
# abre el chat. El token vive unicamente en el worker, que es quien envia y
# recibe: cuantos menos procesos lo tengan, menos superficie de fuga.
TELEGRAM_BOT_USERNAME=

# ═══════════════════════════════════════════════════════════════
# Bitacora de actividad
# ═══════════════════════════════════════════════════════════════
# Registra en la tabla `activity_log` lo que hacen los USUARIOS y todo fallo
# HTTP. No duplica `bot_events`, que sigue siendo la bitacora de cada bot.
#
# Apagado por defecto en produccion: guarda datos personales (IP) y solo lo
# lee un ADMIN. Cualquier valor distinto de `true` lo deja apagado.
AUDIT_LOG_ENABLE=true

# ═══════════════════════════════════════════════════════════════
# Lighter — cuenta de servicio para datos publicos
# ═══════════════════════════════════════════════════════════════
# OPCIONAL, pero sin ella Lighter nos cuenta como cuenta «Standard» y el cupo
# son 60 PETICIONES POR MINUTO para toda la IP de salida, compartidas con
# cualquier otro proceso que salga por ella. Al pasarse, su cortafuegos deja de
# responder JSON y devuelve una pagina CAPTCHA de AWS WAF durante 60 segundos.
#
#   https://apidocs.lighter.xyz/docs/rate-limits
#   «To bypass IP-based rate limits, clients can authenticate each request so
#    that only L1-based rate limits apply.»
#
# Esta cuenta NO opera: solo lee mercados, precios y velas, y nunca firma una
# orden. Por eso no es la de ningun usuario —este camino no debe descifrar la
# clave de nadie para leer un precio— y por eso pasarla al tier «Plus» no cuesta
# nada: Plus cobra 0,5 puntos basicos por OPERACION, y esta cuenta no hace
# ninguna.
#
# Como conseguirlas:
#   1. Crear (o reutilizar) una cuenta de Lighter que no vaya a operar.
#   2. Registrar una clave de API en un indice entre 4 y 254. Los indices 0-3
#      los reserva Lighter para sus aplicaciones de escritorio y movil: usar uno
#      de esos pisa la sesion de la interfaz oficial.
#   3. Opcional pero recomendado: llamar a `changeAccountTier` para pasarla a
#      «Plus» (sin stakear nada). Exige no tener posiciones ni ordenes abiertas
#      y que hayan pasado 24 h desde la ultima llamada — en una cuenta que no
#      opera se cumple solo. Sube el cupo a 120.000 ponderadas por minuto.
#
# Sin rellenar, el sistema arranca igual y ANUNCIA en el log que va sin firmar.
LIGHTER_SERVICE_ACCOUNT_INDEX=
LIGHTER_SERVICE_API_KEY_INDEX=4
LIGHTER_SERVICE_PRIVATE_KEY=

# ═══════════════════════════════════════════════════════════════════════════
# Caudal hacia los venues
# ═══════════════════════════════════════════════════════════════════════════
#
# Identificador de la IP DE SALIDA. Todos los procesos que salgan por la misma IP
# deben llevar el MISMO valor, porque comparten el deposito de fichas en Redis.
#
# La API y el worker cuentan como uno solo: los DEX limitan POR IP, no por
# proceso ni por clave. Cuando cada uno se creia dueno del deposito entero,
# juntos pasaron de las 60 peticiones por minuto que Lighter da a una cuenta sin
# autenticar y su cortafuegos empezo a devolver una pagina CAPTCHA.
#
# `memory` desactiva el deposito compartido y cada proceso lleva el suyo. Solo
# tiene sentido si de verdad sale por su propia IP.
WORKER_EGRESS_ID=shared

# Nota sobre los otros dos venues: no tienen equivalente y no es un olvido.
# Hyperliquid sirve sus endpoints `info` sin credencial, y Aster documenta que
# «the limits on the API are based on the IPs, not the API keys» — una clave
# alli no cambiaria ningun limite.

# ═══════════════════════════════════════════════════════════════════════════
# Configuraciones sugeridas al crear un bot (opcional)
# ═══════════════════════════════════════════════════════════════════════════
#
# El asistente propone tres configuraciones —prudente, equilibrada y agresiva—
# para la estrategia y el par elegidos. Los NUMEROS los calcula siempre el
# servidor con las mismas funciones que ejecuta el motor; el modelo solo elige
# entre bandas discretas y nunca ve un importe ni un precio.
#
# Todas son OPCIONALES a proposito. Sin clave, o con el interruptor apagado, la
# funcion sigue viva y sirve configuraciones calculadas por reglas desde la
# volatilidad del par. La API arranca igual: una ayuda del asistente no puede
# impedir que el servidor levante.
#
# El interruptor manda sobre la clave: con AI_ADVISOR_ENABLE=false no se llama a
# nadie aunque la clave este puesta. Es la forma de cortar el gasto sin tener que
# borrar el secreto del despliegue.
AI_ADVISOR_ENABLE=false

# Clave de OpenRouter. Se saca en https://openrouter.ai/keys, sobre una cuenta
# con saldo (OpenRouter cobra por uso, no por suscripcion).
#
# NUNCA sale de este servidor: la app y el APK no la ven ni la necesitan, porque
# quien habla con el modelo es la API. Una clave de IA en un binario que se
# distribuye es una factura abierta al primero que lo descomprima.
OPENROUTER_API_KEY=

# Modelo, en la forma `proveedor/modelo` de OpenRouter.
#
# Por defecto Claude Sonnet 5: cuesta unos 2 $ por millon de tokens de entrada y
# 10 $ por millon de salida. Cada peticion son ~1.000 de entrada (medidos) y
# hasta ~2.200 de salida contando el razonamiento, o sea alrededor de 0,02 $ en
# el peor caso. Con el cache de una hora y el tope diario de abajo, el gasto real
# de esta funcion son centimos al dia.
#
# ATENCION: esta clave NO enciende nada por si sola. Hace falta ademas
# AI_ADVISOR_ENABLE=true. Con la clave puesta y el interruptor apagado, la API lo
# avisa en el log al arrancar.
#
# Si lo cambias, comprueba en https://openrouter.ai/models que el modelo elegido
# soporta SALIDAS ESTRUCTURADAS: el cliente enruta con `require_parameters`, asi
# que un modelo que no las soporte simplemente no recibira ninguna peticion y
# todo saldra por reglas.
OPENROUTER_MODEL=anthropic/claude-sonnet-5

# Cuantas llamadas PAGADAS puede provocar un usuario al dia.
#
# No limita cuantas veces se pueden pedir recomendaciones: limita cuantas de esas
# peticiones acaban en una llamada de verdad. Mirar veinte veces el mismo par
# sale gratis —lo sirve el cache—; mirar veinte pares distintos gasta veinte.
#
# Al agotarse, el usuario sigue recibiendo sus tres configuraciones, calculadas
# por reglas y con una nota que se lo explica. El contador se reinicia a
# medianoche UTC.
AI_ADVISOR_DAILY_LIMIT=20

# ─────────────────────────────────────────────────────────────────────────────
# BACKTESTING (solo ADMIN)
# ─────────────────────────────────────────────────────────────────────────────
#
# De donde salen las velas historicas para reproducir la configuracion de un bot.
# No son las del venue a proposito: Hyperliquid solo guarda las ultimas 5000
# velas del intervalo —tres dias y medio en 1m, cincuenta y dos en 15m—, asi que
# para treinta dias hay que ir fuera.
#
# BINANCE_* son las MISMAS que ya usa el worker para el precio de referencia en
# vivo: un solo sitio al que apuntar si hace falta un espejo. Se reutilizan aqui
# en vez de duplicarlas.
#
# BYBIT es el respaldo, y existe por el HTTP 451: Binance bloquea territorios y
# rangos de IP de datacenter, asi que un unico proveedor publico significaria
# quedarse sin backtest el dia que cambie el alojamiento.
#
# Sin ninguna de las tres el sistema funciona igual: se toman los valores por
# defecto de abajo.

BINANCE_REST_URL=https://api.binance.com
BINANCE_FAPI_URL=https://fapi.binance.com
BYBIT_REST_URL=https://api.bybit.com
