{
  "name": "worker",
  "version": "0.1.0",
  "description": "CRYPTON worker — motor de bots: lease, reconciliacion y ejecucion contra los DEX",
  "private": true,
  "license": "AGPL-3.0-only",
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main",
    "//lint": "El worker aun no esta lintado: heredo el script de la API sin sus dependencias, asi que fallaba siempre. Ver CONTRIBUTING.",
    "lint": "echo \"sin lint todavia\"",
    "test": "jest",
    "test:watch": "jest --watch"
  },
  "dependencies": {
    "@crypton/db": "workspace:*",
    "@crypton/exchange-core": "workspace:*",
    "@crypton/shared": "workspace:*",
    "@crypton/strategy-core": "workspace:*",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.3",
    "@nestjs/core": "^11.0.1",
    "@nestjs/schedule": "^6.1.1",
    "decimal.js": "^10.6.0",
    "redis": "^5.10.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.0",
    "jest": "^30.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3"
  },
  "jest": {
    "moduleFileExtensions": ["js", "json", "ts"],
    "rootDir": "src",
    "moduleDirectories": ["node_modules", "<rootDir>/.."],
    "testRegex": "\\.spec\\.ts$",
    "transform": { "^.+\\.(t|j)s$": "ts-jest" },
    "testEnvironment": "node"
  }
}
