# ═══════════════════════════════════════════════════════════════
# Worker — motor de bots
# ═══════════════════════════════════════════════════════════════
NODE_ENV=development

DATABASE_URL=postgresql://postgres:postgres@localhost:5341/crypton?schema=public&connection_limit=10

REDIS_URL=redis://localhost:6381
REDIS_PASSWORD=changeme

# La MISMA clave maestra que la API: el worker descifra las credenciales que
# la API cifró. Si no coinciden, ningun bot puede arrancar.
CREDENTIALS_MASTER_KEY=
CREDENTIALS_ACTIVE_KEY_ID=v1

# ═══════════════════════════════════════════════════════════════
# Motor
# ═══════════════════════════════════════════════════════════════
# Cada cuanto busca bots huerfanos que adoptar.
ENGINE_SCAN_INTERVAL_MS=5000

# Latido de reconciliacion. Es el techo de latencia cuando el WebSocket del
# venue se cae en silencio: hasta ese punto el bot converge igualmente por REST.
# Bajarlo mucho multiplica las llamadas a la API del exchange sin ganar apenas,
# porque los fills ya disparan un tick inmediato.
RECONCILE_INTERVAL_MS=15000

# Vida del lease de un bot. Si un worker muere, otro lo adopta pasado este
# tiempo. Demasiado corto provoca relevos innecesarios ante un pico de latencia;
# demasiado largo alarga el hueco en el que nadie atiende al bot.
WORKER_LEASE_TTL_MS=30000

# Cuantos bots acepta ESTE worker. Al llegar al tope deja de adquirir leases y
# los bots que sobren esperan a que haya otra replica. Sin tope, la primera
# replica que arranca se los lleva todos y no queda reparto ninguno.
WORKER_MAX_BOTS=250

# Puerto del endpoint de salud (/health). Devuelve cuantos bots lleva este
# proceso; es lo que consulta el healthcheck del contenedor.
WORKER_HEALTH_PORT=3300

# ═══════════════════════════════════════════════════════════════
# Caudal hacia los venues
# ═══════════════════════════════════════════════════════════════
# Los DEX limitan en DOS ambitos y hay un ajuste para cada uno.

# 1) Por CUENTA de exchange. El adaptador se comparte entre todos los bots de
#    una misma cuenta, asi que este numero significa lo que dice. (Cuando habia
#    un adaptador por bot, diez bots de una cuenta mandaban ochenta peticiones
#    por segundo con esto puesto a ocho.)
VENUE_RATE_LIMIT_PER_SECOND=8

# 2) Por IP de salida. Los procesos que compartan salida a internet DEBEN
#    compartir este valor: es lo que les hace compartir presupuesto en Redis.
#    Ponlo a `memory` solo si cada worker sale por su propia IP — entonces el
#    presupuesto se lleva en el proceso y no cruza la red.
WORKER_EGRESS_ID=shared

# Cuanto vale una lectura de estado de cuenta (posiciones, saldo, ordenes)
# antes de repetirla. Es lo que hace que diez bots de la misma cuenta latiendo
# a la vez cuesten UNA llamada en vez de diez. Subirlo ahorra caudal a cambio
# de planificar sobre datos algo mas viejos.
ACCOUNT_STATE_TTL_MS=1000

# Caudal del feed PUBLICO de precios. Es un adaptador sin credenciales, uno por
# venue y proceso, compartido por todos los bots: los precios son informacion
# publica y no hay ninguna razon para pedirlos una vez por bot.
MARKETDATA_RATE_LIMIT_PER_SECOND=6

# Saldo inicial de los bots en modo simulacion.
DRY_RUN_BALANCE=10000

# ═══════════════════════════════════════════════════════════════
# Retencion de las series temporales
# ═══════════════════════════════════════════════════════════════
# `bot_snapshots` y `bot_events` crecen sin parar. El historico de verdad —lo
# que de verdad paso— vive en bot_cycles, bot_orders y bot_fills, que NO se
# purgan nunca. Estos dos son para pintar graficas y para el timeline.
#
# Poner cualquiera a 0 desactiva su purga.
RETENTION_SNAPSHOT_DAYS=30
RETENTION_EVENT_DAYS=90

# Los eventos graves se guardan mucho mas: un FILL de hace tres meses no le
# importa a nadie, pero un RISK_GUARD_TRIPPED o un AUTH_ERROR son justo lo que
# se va a mirar cuando algo salga mal.
RETENTION_CRITICAL_EVENT_DAYS=365

# ═══════════════════════════════════════════════════════════════
# Bitacora de actividad
# ═══════════════════════════════════════════════════════════════
# El motor registra aqui lo que hoy solo iba a stdout: leases perdidos y la
# cancelacion de emergencia de un bot ya borrado. NADA por ciclo: con el tick
# de 15 s y 250 bots serian 1,44 millones de filas al dia.
AUDIT_LOG_ENABLE=true

# Retencion de la bitacora. Los registros CRITICAL se guardan lo mismo que los
# eventos graves (RETENTION_CRITICAL_EVENT_DAYS). 0 desactiva la purga.
RETENTION_AUDIT_DAYS=180

# ═══════════════════════════════════════════════════════════════
# Comisiones de plataforma (builder / integrator)
# ═══════════════════════════════════════════════════════════════
# Direccion que recibe la comision y su tasa en decimas de punto basico
# (1 = 0,0001 %). Deben coincidir con las de la API: es la misma comision, y el
# worker adjunta el mismo dato a las ordenes que manda el motor.
#
# Solo se adjunta a las ordenes de las cuentas que hayan FIRMADO la aprobacion en
# el venue: sin ella, el exchange rechaza la orden entera, no solo la comision.
BUILDER_ADDRESS=
BUILDER_FEE_TENTH_BPS=0

# ═══════════════════════════════════════════════════════════════
# Telegram
# ═══════════════════════════════════════════════════════════════
# Token del bot (lo da @BotFather). Sin el, las alertas quedan desactivadas y
# el resto del motor funciona igual.
#
# Solo UN worker sondea Telegram a la vez, coordinado por un cerrojo en Redis:
# getUpdates entrega cada mensaje una sola vez, y dos lectores se robarian los
# mensajes el uno al otro de forma intermitente.
TELEGRAM_BOT_TOKEN=

# ═══════════════════════════════════════════════════════════════
# FUENTES DE PRECIO EXTERNAS (opcional)
# ═══════════════════════════════════════════════════════════════
#
# Solo las usa el Market Maker V2 cuando su `priceSource` es BINANCE.
#
# El motivo de que exista esta opcion: un market maker que cotiza contra el mid
# de su propio libro esta anclado a un precio QUE EL MISMO MUEVE — en un par poco
# liquido sus ordenes *son* el precio. Anclar a un mercado grande y ajeno rompe
# ese bucle.
#
# Binance NO se usa jamas para operar: el proyecto opera contra DEX. Aqui es solo
# un oraculo de lectura, y por eso son APIS PUBLICAS SIN CREDENCIALES — el worker
# no puede firmar nada con esto.
#
# Si un bot pide una fuente y esta no responde, el bot DEJA DE COTIZAR y avisa
# con FAIR_PRICE_STALE. No cae al precio del venue por su cuenta: quien eligio
# anclar a Binance lo hizo porque no se fia del mid local.
#
# Cual se usa la decide `sourceMarketType` de cada bot:
#
#   SPOT          -> BINANCE_REST_URL   (contado)
#   PERP e INDEX  -> BINANCE_FAPI_URL   (futuros USDs-M: perpetuo y precio de indice)
#
# El simbolo se compone como «<base>USDT» y NO se respeta la quote del venue: en
# Binance la liquidez de referencia esta en los pares USDT, y un BTCUSDC con la
# decima parte del volumen daria un precio peor que el del propio venue. Para un
# par que alli se llame distinto —1000PEPEUSDT— esta el campo «simbolo de origen
# alternativo» en la configuracion del bot.
#
# Sin estas variables el sistema funciona igual; solo se toman los valores por
# defecto de abajo. Cambialas solo para apuntar a una replica o a un proxy.

BINANCE_REST_URL=https://api.binance.com
BINANCE_FAPI_URL=https://fapi.binance.com

# ═══════════════════════════════════════════════════════════════
# Lighter — cuenta de servicio para datos publicos
# ═══════════════════════════════════════════════════════════════
# OPCIONAL, pero sin ella Lighter nos cuenta como cuenta «Standard» y el cupo
# son 60 PETICIONES POR MINUTO para toda la IP de salida, compartidas con
# cualquier otro proceso que salga por ella. Al pasarse, su cortafuegos deja de
# responder JSON y devuelve una pagina CAPTCHA de AWS WAF durante 60 segundos.
#
#   https://apidocs.lighter.xyz/docs/rate-limits
#   «To bypass IP-based rate limits, clients can authenticate each request so
#    that only L1-based rate limits apply.»
#
# Esta cuenta NO opera: solo lee mercados, precios y velas, y nunca firma una
# orden. Por eso no es la de ningun usuario —este camino no debe descifrar la
# clave de nadie para leer un precio— y por eso pasarla al tier «Plus» no cuesta
# nada: Plus cobra 0,5 puntos basicos por OPERACION, y esta cuenta no hace
# ninguna.
#
# Como conseguirlas:
#   1. Crear (o reutilizar) una cuenta de Lighter que no vaya a operar.
#   2. Registrar una clave de API en un indice entre 4 y 254. Los indices 0-3
#      los reserva Lighter para sus aplicaciones de escritorio y movil: usar uno
#      de esos pisa la sesion de la interfaz oficial.
#   3. Opcional pero recomendado: llamar a `changeAccountTier` para pasarla a
#      «Plus» (sin stakear nada). Exige no tener posiciones ni ordenes abiertas
#      y que hayan pasado 24 h desde la ultima llamada — en una cuenta que no
#      opera se cumple solo. Sube el cupo a 120.000 ponderadas por minuto.
#
# Sin rellenar, el sistema arranca igual y ANUNCIA en el log que va sin firmar.
LIGHTER_SERVICE_ACCOUNT_INDEX=
LIGHTER_SERVICE_API_KEY_INDEX=4
LIGHTER_SERVICE_PRIVATE_KEY=

# Nota sobre los otros dos venues: no tienen equivalente y no es un olvido.
# Hyperliquid sirve sus endpoints `info` sin credencial, y Aster documenta que
# «the limits on the API are based on the IPs, not the API keys» — una clave
# alli no cambiaria ningun limite.
